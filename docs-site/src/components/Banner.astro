---
// The release-status line, on every page. It replaces Starlight's Banner, which shows only when a
// page sets `banner:` in its frontmatter; here no page can leave it out. scripts/check-copy.mjs
// fails the build when a built page lacks it, or when the release it names is not one
// CHANGELOG.md has stamped. Refresh it with the rest of the docs at the next release, by changing
// DOCUMENTED in scripts/releases.mjs and this wording together.
import { DOCUMENTED, releaseUrl } from '../../scripts/releases.mjs';
---

<div class="sl-banner sb-release" role="note" aria-label="Release status" data-pagefind-ignore>
  <strong>SuperBench {DOCUMENTED} is released</strong> as an experimental single-host release:
  Linux amd64, for trusted repositories on one host, and not production software.
  <a href={releaseUrl(DOCUMENTED)}>Release notes</a> ·
  <a href="/start/install/">Install</a> · <a href="/start/status/">Status</a>
</div>

<style>
  @layer starlight.core {
    .sl-banner {
      --__sl-banner-text: var(--sl-color-white);
      padding: var(--sl-nav-pad-y) var(--sl-nav-pad-x);
      background-color: color-mix(in oklab, var(--sjl-status-wet-paint, var(--sl-color-accent)) 26%, var(--sl-color-black));
      border-block-end: 1px solid color-mix(in oklab, var(--sjl-status-wet-paint, var(--sl-color-accent)) 55%, transparent);
      color: var(--__sl-banner-text);
      line-height: var(--sl-line-height-headings);
      text-align: center;
      text-wrap: balance;
      font-size: var(--sl-text-sm);
    }
    .sl-banner a {
      color: inherit;
      text-decoration: underline;
      text-underline-offset: 0.15em;
    }
    .sl-banner code {
      font-size: 0.9em;
      padding: 0.05em 0.3em;
      border-radius: 4px;
      background: color-mix(in oklab, var(--sl-color-white) 10%, transparent);
    }
  }
</style>
