// superbench.dev: a Worker with static assets and no script.
//
// Not a classic Pages project: wrangler no longer creates those. The custom domains are declared
// here, so `wrangler deploy` attaches them; no dashboard step. Deployed by
// scripts/deploy-sites.sh once the deploy workflow exists; until superbench.dev is in the
// Cloudflare account, nothing deploys this.
{
  "name": "superbench-site",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./dist", "not_found_handling": "404-page" },
  "routes": [
    { "pattern": "superbench.dev", "custom_domain": true },
    { "pattern": "www.superbench.dev", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false
}
